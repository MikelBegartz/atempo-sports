# Copia a .env i omple els valors. No pujis .env al git.

# production | development
ATEMPO_ENV=development

# 1 = cookie de sessió només per HTTPS (recomanat en producció)
ATEMPO_HTTPS=0

# 1 = obre el registre públic (per defecte tancat a la beta)
ATEMPO_PUBLIC_REGISTER=0

# Contrasenya d’operador (/admin). Si no hi és, se’n genera una a data/.admin_password
# ATEMPO_ADMIN_PASSWORD=

# Paraula de recuperació (recordable). Millor definir-la des de /admin.
# ATEMPO_ADMIN_RECOVERY=

# Opcional: només aquestes IPs poden provar /admin (separades per coma).
# ATEMPO_ADMIN_ALLOW_IPS=

# Demo Mataró: en local, sense això la clau pot ser «mataro».
# En producció (ATEMPO_ENV=production) cal una clau forta aquí, o el demo queda sense accés.
# ATEMPO_DEMO_PASSWORD=
# ATEMPO_ALLOW_DEMO=1

# Correu real per «he oblidat la contrasenya»
# Port 587 = STARTTLS · Port 465 = SSL
# ATEMPO_SMTP_HOST=smtp.exemple.com
# ATEMPO_SMTP_PORT=587
# ATEMPO_SMTP_USER=
# ATEMPO_SMTP_PASSWORD=
# ATEMPO_SMTP_FROM=AtempoSports <noreply@el-teu-domini.cat>
